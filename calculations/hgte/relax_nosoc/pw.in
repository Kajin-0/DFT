&CONTROL
   calculation = 'vc-relax'
   pseudo_dir = '/home/User/opencode_workspace/DFT/pseudopotentials'
   outdir = '/home/User/opencode_workspace/DFT/calculations/hgte/relax_nosoc/out'
   verbosity = 'high'
   tprnfor = .true.
   tstress = .true.
   wf_collect = .true.
/

&SYSTEM
   ibrav = 0
   nat = 2
   ntyp = 2
   ecutwfc = 120.0
   occupations = 'fixed'
   ecutrho = 720.0
/

&ELECTRONS
   conv_thr = 1e-10
   mixing_beta = 0.3
   electron_maxstep = 200
   diagonalization = 'david'
/

&IONS
   ion_dynamics = 'bfgs'
/

&CELL
   cell_dynamics = 'bfgs'
   cell_factor = 3.0
/

ATOMIC_SPECIES
  Hg   200.5920  Hg.pbe-spn-rrkjus_psl.1.0.0.UPF
  Te   127.6000  Te.pbe-n-rrkjus_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
   0.000000000000  3.226500000000  3.226500000000
   3.226500000000  0.000000000000  3.226500000000
   3.226500000000  3.226500000000  0.000000000000

ATOMIC_POSITIONS crystal
  Hg    0.000000000000  0.000000000000  0.000000000000
  Te    0.250000000000  0.250000000000  0.250000000000

K_POINTS automatic
  10 10 10  0 0 0
