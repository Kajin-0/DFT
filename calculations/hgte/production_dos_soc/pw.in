&CONTROL
   calculation = 'nscf'
   pseudo_dir = '/home/User/opencode_workspace/DFT/pseudopotentials'
   outdir = '/home/User/opencode_workspace/DFT/calculations/hgte/production_dos_soc/out'
   verbosity = 'high'
   tprnfor = .false.
   tstress = .false.
   wf_collect = .true.
/

&SYSTEM
   ibrav = 0
   nat = 2
   ntyp = 2
   ecutwfc = 120.0
   occupations = 'tetrahedra'
   ecutrho = 720.0
   smearing = 'mv'
   degauss = 0.005
   nbnd = 38
   noncolin = .true.
   lspinorb = .true.
/

&ELECTRONS
   conv_thr = 1e-10
   mixing_beta = 0.3
   electron_maxstep = 200
   diagonalization = 'david'
/

ATOMIC_SPECIES
  Hg   200.5920  Hg.rel-pbe-spn-rrkjus_psl.1.0.0.UPF
  Te   127.6000  Te.rel-pbe-n-rrkjus_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
   0.000000000000  3.315076000000  3.315076000000
   3.315076000000  0.000000000000  3.315076000000
   3.315076000000  3.315076000000  0.000000000000

ATOMIC_POSITIONS crystal
  Hg    0.000000000000  0.000000000000  0.000000000000
  Te    0.250000000000  0.250000000000  0.250000000000

K_POINTS automatic
  14 14 14  0 0 0
