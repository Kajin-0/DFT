&CONTROL
   calculation = 'nscf'
   pseudo_dir = '/home/User/opencode_workspace/DFT/pseudopotentials'
   outdir = '/home/User/opencode_workspace/DFT/calculations/cdte/optics_nc/out'
   verbosity = 'high'
   tprnfor = .false.
   tstress = .false.
   wf_collect = .true.
/

&SYSTEM
   ibrav = 0
   nat = 2
   ntyp = 2
   ecutwfc = 60.0
   occupations = 'fixed'
   ecutrho = 240.0
   nbnd = 50
   nosym = .true.
   noinv = .true.
/

&ELECTRONS
   conv_thr = 1e-10
   mixing_beta = 0.3
   electron_maxstep = 200
   diagonalization = 'david'
/

ATOMIC_SPECIES
  Cd   112.4140  Cd_ONCV_PBE-1.2.upf
  Te   127.6000  Te_ONCV_PBE-1.2.upf

CELL_PARAMETERS angstrom
   0.000000000000  3.311522000000  3.311522000000
   3.311522000000  0.000000000000  3.311522000000
   3.311522000000  3.311522000000  0.000000000000

ATOMIC_POSITIONS crystal
  Cd    0.000000000000  0.000000000000  0.000000000000
  Te    0.250000000000  0.250000000000  0.250000000000

K_POINTS automatic
  6 6 6  0 0 0
